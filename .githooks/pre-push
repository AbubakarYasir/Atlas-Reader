#!/bin/sh
# Owner identity and cryptographic signature gate for newly published commits.
set -eu
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
    if git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
        commits=$(git rev-list "$remote_oid..$local_oid")
    else
        commits=$(git rev-list "$local_oid" --not --remotes)
    fi
    for commit in $commits; do
        identity=$(git show -s --format='%an|%ae|%cn|%ce' "$commit")
        if [ "$identity" != 'Abu Bakar Yasir|theabubakaryasir@gmail.com|Abu Bakar Yasir|theabubakaryasir@gmail.com' ]; then
            echo "Push refused: incorrect owner identity at $commit" >&2
            exit 1
        fi
        git verify-commit "$commit" || exit 1
    done
done
